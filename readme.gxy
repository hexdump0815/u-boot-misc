cd /compile/source

# arm trusted firmware:
git clone https://github.com/ARM-software/arm-trusted-firmware.git arm-trusted-firmware-gxy
cd arm-trusted-firmware-gxy
git checkout v2.14
# adjust errata for g12a - do not use this if the sm1 patch below is used - not sure if this is very useful
#patch -p1 < /compile/doc/u-boot-misc/misc.gxy/atf-g12a-errata.patch
# by default the result will be for g12a, for sm1 (instead) the following patch is needed - not used as sm1 atf is not working well
#patch -p1 < /compile/doc/u-boot-misc/misc.gxy/atf-sm1-support.patch
make realclean
make -j 4 PLAT=g12a DEBUG=1 bl31
# result: build/g12a/debug/bl31.bin
cd ..

# u-boot:
git clone https://gitlab.denx.de/u-boot/u-boot.git u-boot-mainline-gxy
cd u-boot-mainline-gxy
git checkout v2026.04
# add usb kbd and uEnv.txt support
patch -p1 < /compile/doc/u-boot-misc/misc.gxy/add-usb-kbd-and-uenv-txt-and-own-strings.patch

# s905x2 = g12a
make clean
make sei510_defconfig
make -j 4
cp u-boot.bin g12a-tv-box-u-boot.bin

# s905x3 = sm1
make clean
make sei610_defconfig
make -j 4
cp u-boot.bin sm1-tv-box-u-boot.bin

# remove usb kbd and uEnv.txt support
patch -p1 -R < /compile/doc/u-boot-misc/misc.gxy/add-usb-kbd-and-uenv-txt-and-own-strings.patch
# add only uEnv.txt support
patch -p1 < /compile/doc/u-boot-misc/misc.gxy/add-uenv-txt-and-own-strings.patch

# s905x2 = g12a
make clean
make sei510_defconfig
make -j 4
cp u-boot.bin g12a-tv-box-serial-u-boot.bin

# s905x3 = sm1
make clean
make sei610_defconfig
make -j 4
cp u-boot.bin sm1-tv-box-serial-u-boot.bin

cd ..

# get and install the meson64-tools
git clone https://github.com/angerman/meson64-tools
cd meson64-tools
# required on modern systems due to missing python2
patch -p1 < /compile/doc/u-boot-misc/misc.gxy/meson64-tools-disable-tests-due-to-missing-python2.patch
# -k as the tests compile fails due to missing python2
make -k all
cd ..

# boot block creation

mkdir u-boot-workdir-gxy
cd u-boot-workdir-gxy

# get the amlogic boot fip blobs and prepare them
git clone https://github.com/LibreELEC/amlogic-boot-fip

# assembls the u-boot boot image - original atf case - sm1
mkdir data
cp amlogic-boot-fip/odroid-c4/* data
# alternative
# cp amlogic-boot-fip/sei610/* data
# to get the acs memory timings dump /dev/mmcblkXboot0 or the beginning of /dev/mmcblkX
# and dd edit out the part which looks like the regular acs.bin in hexdump -C
#
# example: some x96 air 2g/16g tv box
# dd if=mmcblk2boot0.dd of=tmp.dd bs=1 skip=61952 status=progress
# dd if=tmp.dd of=acs-x96-air-2-16.bin bs=1 count=4112 status=progress
# rm -f tmp.dd
cp /compile/doc/u-boot-misc/misc.gxy/acs-x96-air-2-16.bin.gz data/acs.bin.gz
gunzip -f data/acs.bin.gz
../meson64-tools/pkg --type bl30 --output bl30.pkg data/bl30.bin data/bl301.bin
../meson64-tools/pkg --type bl2 --output bl2.pkg data/bl2.bin data/acs.bin
../meson64-tools/bl30sig --input bl30.pkg --output bl30.30sig
../meson64-tools/bl3sig --input bl30.30sig --output bl30.3sig
../meson64-tools/bl3sig --input data/bl31.img --output bl31.3sig
../meson64-tools/bl3sig --input ../u-boot-mainline-gxy/sm1-tv-box-u-boot.bin --output bl33.3sig
../meson64-tools/bl2sig --input bl2.pkg --output bl2.2sig
../meson64-tools/bootmk --output gxy-boot.bin --bl2 bl2.2sig --bl30 bl30.3sig --bl31 bl31.3sig --bl33 bl33.3sig --ddrfw1 data/ddr4_1d.fw --ddrfw2 data/ddr4_2d.fw --ddrfw3 data/ddr3_1d.fw --ddrfw4 data/piei.fw --ddrfw5 data/lpddr4_1d.fw --ddrfw6 data/lpddr4_2d.fw --ddrfw7 data/diag_lpddr4.fw --ddrfw8 data/lpddr3_1d.fw --ddrfw9 data/aml_ddr.fw

# prepare it for imagebuilder
dd if=/dev/zero of=boot-sm1-tv-box-aarch64.dd bs=512 count=1
cat gxy-boot.bin >> boot-sm1-tv-box-aarch64.dd
cp boot-sm1-tv-box-aarch64.dd ../u-boot-mainline-gxy

# cleanup
rm -f bl30.pkg bl2.pkg bl30.30sig bl30.3sig bl31.3sig bl33.3sig bl2.2sig gxy-boot.bin boot-sm1-tv-box-aarch64.dd
rm -rf data

# assembls the u-boot boot image - mainline atf case - g12a
mkdir data
cp amlogic-boot-fip/sei510/* data
cp ../arm-trusted-firmware-gxy/build/g12a/debug/bl31.bin data/bl31.bin-atf
# use the header of he original bl31.img
dd if=data/bl31.img of=data/bl31.img-atf bs=512 count=1
cat data/bl31.bin-atf >> data/bl31.img-atf
cp /compile/doc/u-boot-misc/misc.gxy/acs-x96-max-2-16.bin.gz data/acs.bin.gz
gunzip -f data/acs.bin.gz
../meson64-tools/pkg --type bl30 --output bl30.pkg data/bl30.bin data/bl301.bin
../meson64-tools/pkg --type bl2 --output bl2.pkg data/bl2.bin data/acs.bin
../meson64-tools/bl30sig --input bl30.pkg --output bl30.30sig
../meson64-tools/bl3sig --input bl30.30sig --output bl30.3sig
../meson64-tools/bl3sig --input data/bl31.img-atf --output bl31.3sig-atf
../meson64-tools/bl3sig --input ../u-boot-mainline-gxy/g12a-tv-box-u-boot.bin --output bl33.3sig
../meson64-tools/bl2sig --input bl2.pkg --output bl2.2sig
../meson64-tools/bootmk --output gxy-boot.bin --bl2 bl2.2sig --bl30 bl30.3sig --bl31 bl31.3sig-atf --bl33 bl33.3sig --ddrfw1 data/ddr4_1d.fw --ddrfw2 data/ddr4_2d.fw --ddrfw3 data/ddr3_1d.fw --ddrfw4 data/piei.fw --ddrfw5 data/lpddr4_1d.fw --ddrfw6 data/lpddr4_2d.fw --ddrfw7 data/diag_lpddr4.fw --ddrfw8 data/lpddr3_1d.fw --ddrfw9 data/aml_ddr.fw

# prepare it for imagebuilder
dd if=/dev/zero of=boot-g12a-tv-box-aarch64.dd bs=512 count=1
cat gxy-boot.bin >> boot-g12a-tv-box-aarch64.dd
cp boot-g12a-tv-box-aarch64.dd ../u-boot-mainline-gxy

# cleanup
rm -f bl30.pkg bl2.pkg bl30.30sig bl30.3sig bl31.3sig-atf bl33.3sig bl2.2sig gxy-boot.bin boot-g12a-tv-box-aarch64.dd
rm -rf data

# and now the booblock with usb keyboard support for serial only
# assembls the u-boot boot image - original atf case - sm1
mkdir data
cp amlogic-boot-fip/odroid-c4/* data
cp /compile/doc/u-boot-misc/misc.gxy/acs-x96-air-2-16.bin.gz data/acs.bin.gz
gunzip -f data/acs.bin.gz
../meson64-tools/pkg --type bl30 --output bl30.pkg data/bl30.bin data/bl301.bin
../meson64-tools/pkg --type bl2 --output bl2.pkg data/bl2.bin data/acs.bin
../meson64-tools/bl30sig --input bl30.pkg --output bl30.30sig
../meson64-tools/bl3sig --input bl30.30sig --output bl30.3sig
../meson64-tools/bl3sig --input data/bl31.img --output bl31.3sig
../meson64-tools/bl3sig --input ../u-boot-mainline-gxy/sm1-tv-box-serial-u-boot.bin --output bl33.3sig
../meson64-tools/bl2sig --input bl2.pkg --output bl2.2sig
../meson64-tools/bootmk --output gxy-boot.bin --bl2 bl2.2sig --bl30 bl30.3sig --bl31 bl31.3sig --bl33 bl33.3sig --ddrfw1 data/ddr4_1d.fw --ddrfw2 data/ddr4_2d.fw --ddrfw3 data/ddr3_1d.fw --ddrfw4 data/piei.fw --ddrfw5 data/lpddr4_1d.fw --ddrfw6 data/lpddr4_2d.fw --ddrfw7 data/diag_lpddr4.fw --ddrfw8 data/lpddr3_1d.fw --ddrfw9 data/aml_ddr.fw

# prepare it for imagebuilder
dd if=/dev/zero of=boot-sm1-tv-box-serial-aarch64.dd bs=512 count=1
cat gxy-boot.bin >> boot-sm1-tv-box-serial-aarch64.dd
cp boot-sm1-tv-box-serial-aarch64.dd ../u-boot-mainline-gxy

# cleanup
rm -f bl30.pkg bl2.pkg bl30.30sig bl30.3sig bl31.3sig bl33.3sig bl2.2sig gxy-boot.bin boot-sm1-tv-box-serial-aarch64.dd
rm -rf data

# assembls the u-boot boot image - mainline atf case - g12a
mkdir data
cp amlogic-boot-fip/sei510/* data
cp ../arm-trusted-firmware-gxy/build/g12a/debug/bl31.bin data/bl31.bin-atf
# use the header of he original bl31.img
dd if=data/bl31.img of=data/bl31.img-atf bs=512 count=1
cat data/bl31.bin-atf >> data/bl31.img-atf
cp /compile/doc/u-boot-misc/misc.gxy/acs-x96-max-2-16.bin.gz data/acs.bin.gz
gunzip -f data/acs.bin.gz
../meson64-tools/pkg --type bl30 --output bl30.pkg data/bl30.bin data/bl301.bin
../meson64-tools/pkg --type bl2 --output bl2.pkg data/bl2.bin data/acs.bin
../meson64-tools/bl30sig --input bl30.pkg --output bl30.30sig
../meson64-tools/bl3sig --input bl30.30sig --output bl30.3sig
../meson64-tools/bl3sig --input data/bl31.img-atf --output bl31.3sig-atf
../meson64-tools/bl3sig --input ../u-boot-mainline-gxy/g12a-tv-box-serial-u-boot.bin --output bl33.3sig
../meson64-tools/bl2sig --input bl2.pkg --output bl2.2sig
../meson64-tools/bootmk --output gxy-boot.bin --bl2 bl2.2sig --bl30 bl30.3sig --bl31 bl31.3sig-atf --bl33 bl33.3sig --ddrfw1 data/ddr4_1d.fw --ddrfw2 data/ddr4_2d.fw --ddrfw3 data/ddr3_1d.fw --ddrfw4 data/piei.fw --ddrfw5 data/lpddr4_1d.fw --ddrfw6 data/lpddr4_2d.fw --ddrfw7 data/diag_lpddr4.fw --ddrfw8 data/lpddr3_1d.fw --ddrfw9 data/aml_ddr.fw

# prepare it for imagebuilder
dd if=/dev/zero of=boot-g12a-tv-box-serial-aarch64.dd bs=512 count=1
cat gxy-boot.bin >> boot-g12a-tv-box-serial-aarch64.dd
cp boot-g12a-tv-box-serial-aarch64.dd ../u-boot-mainline-gxy

# cleanup
rm -f bl30.pkg bl2.pkg bl30.30sig bl30.3sig bl31.3sig-atf bl33.3sig bl2.2sig gxy-boot.bin boot-g12a-tv-box-serial-aarch64.dd
rm -rf data
