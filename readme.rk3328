cd /compile/source

# arm trusted firmware:
# atf is only used in case the full mainline bootblocks are written to disk
# otherwise the legacy atf from emmc will be used
git clone https://github.com/ARM-software/arm-trusted-firmware.git arm-trusted-firmware-rk3328
cd arm-trusted-firmware-rk3328
# v2.14.0 results in "region `PMUSRAM' overflowed by 8 bytes"
# see: https://libera.catirclogs.org/linux-rockchip/2025-10-22#
# also: https://github.com/ARM-software/tf-issues/issues/650
# maybe patch 01-fix-building-under-gcc15.patch helps too?
# so lets use v2.13.0 for now
git checkout v2.13.0
# patches for rk3328/rk3318
for i in /compile/doc/u-boot-misc/misc.rk3328/patches/atf-v2.13.0/armbian/*.patch; do
  echo === $i
  patch -p1 < $i
done
make realclean
make -j 4 PLAT=rk3328 DEBUG=1 bl31
# result: build/rk3328/debug/bl31/bl31.elf
cd ..

# u-boot:
git clone https://gitlab.denx.de/u-boot/u-boot.git u-boot-mainline-rk3328
cd u-boot-mainline-rk3328
# armbian patches are based on v2025.10 so lets use that version for now
git checkout v2025.10
# patches for rk3328/rk3318
for i in /compile/doc/u-boot-misc/misc.rk3328/patches/v2025.10/armbian/*.patch; do
  echo === $i
  patch -p1 < $i
done
# use atf from atf build
export BL31=../arm-trusted-firmware-rk3328/build/rk3328/debug/bl31/bl31.elf
export ROCKCHIP_TPL=/compile/doc/u-boot-misc/misc.rk3328/rk3328_ddr_v1.16.bin
make rk3318-box_defconfig
# required: apt-get -y install python3-pyelftools
make -j 4
cp u-boot.bin rk3328-v1.16-u-boot.bin
cp u-boot-rockchip.bin rk3328-v1.16-u-boot-rockchip.bin

# prepare it for imagebuilder/sonaremin
dd if=/dev/zero of=boot-rk3328-ddrbin-v1.16-spl-aarch64.dd bs=512 count=64
cat rk3328-v1.16-u-boot-rockchip.bin >> boot-rk3328-ddrbin-v1.16-spl-aarch64.dd

export ROCKCHIP_TPL=/compile/doc/u-boot-misc/misc.rk3328/rk3328_ddr_333MHz_v1.15.bin
make rk3318-box_defconfig
make -j 4
cp u-boot.bin rk3328-v1.15-u-boot.bin
cp u-boot-rockchip.bin rk3328-v1.15-u-boot-rockchip.bin

# prepare it for imagebuilder/sonaremin
dd if=/dev/zero of=boot-rk3328-ddrbin-v1.15-spl-aarch64.dd bs=512 count=64
cat rk3328-v1.15-u-boot-rockchip.bin >> boot-rk3328-ddrbin-v1.15-spl-aarch64.dd

export ROCKCHIP_TPL=/compile/doc/u-boot-misc/misc.rk3328/rk3328_ddr_333MHz_v1.15-666mhz.bin
make rk3318-box_defconfig
make -j 4
cp u-boot.bin rk3328-v1.15-666mhz-u-boot.bin
cp u-boot-rockchip.bin rk3328-v1.15-666mhz-u-boot-rockchip.bin

# prepare it for imagebuilder/sonaremin
dd if=/dev/zero of=boot-rk3328-ddrbin-v1.15-666mhz-spl-aarch64.dd bs=512 count=64
cat rk3328-v1.15-666mhz-u-boot-rockchip.bin >> boot-rk3328-ddrbin-v1.15-666mhz-spl-aarch64.dd
