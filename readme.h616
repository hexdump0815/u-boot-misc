cd /compile/source

# arm trusted firmware:
git clone https://github.com/ARM-software/arm-trusted-firmware.git arm-trusted-firmware-h616
cd arm-trusted-firmware-h616
git checkout v2.14.0
make realclean
make -j 4 PLAT=sun50i_h616 DEBUG=1 bl31
# result: build/sun50i_h616/debug/bl31.bin
cp build/sun50i_h616/debug/bl31.bin build/sun50i_h616/debug/h616-bl31.bin
cd ..

# u-boot:
git clone https://gitlab.denx.de/u-boot/u-boot.git u-boot-h616
cd u-boot-h616
git checkout v2026.04
# patches for h313/h616/h618
for i in /compile/doc/u-boot-misc/misc.h616/patches/v2026.04/*.patch; do
  echo === $i
  patch -p1 < $i
done
# get atf from aft build
cp ../arm-trusted-firmware-h616/build/sun50i_h616/debug/bl31.bin .
make clean
# h618 tv boxes - transpeed_8x618
make transpeed-8k618-t_defconfig
# own additions:
# required now: apt-get install swig libpython3-dev python3-dev python3-setuptools libgnutls28-dev
make -j 4
# result: u-boot-sunxi-with-spl.bin - dd with bs=1024 seek=8

# prepare transpeed-8k618-t for imagebuilder
dd if=/dev/zero of=boot-allwinner_h616-transpeed-8k618-t-aarch64.dd bs=1024 count=8
cat u-boot-sunxi-with-spl.bin >> boot-allwinner_h616-transpeed-8k618-t-aarch64.dd
cp u-boot.bin h616-transpeed-8k618-t-u-boot.bin
cp u-boot-sunxi-with-spl.bin h616-transpeed-8k618-t-u-boot-sunxi-with-spl.bin

# h616 tv boxes - x96_mate
make clean
make x96_mate_defconfig
make -j 4

# prepare x96_mate for imagebuilder
dd if=/dev/zero of=boot-allwinner_h616-x96_mate-aarch64.dd bs=1024 count=8
cat u-boot-sunxi-with-spl.bin >> boot-allwinner_h616-x96_mate-aarch64.dd
cp u-boot.bin h616-x96_mate-u-boot.bin
cp u-boot-sunxi-with-spl.bin h616-x96_mate-u-boot-sunxi-with-spl.bin

# h313 tv boxes - x96q
make clean
make x96q_defconfig
make -j 4

# prepare x96q for imagebuilder
dd if=/dev/zero of=boot-allwinner_h616-x96q-aarch64.dd bs=1024 count=8
cat u-boot-sunxi-with-spl.bin >> boot-allwinner_h616-x96q-aarch64.dd
cp u-boot.bin h616-x96q-u-boot.bin
cp u-boot-sunxi-with-spl.bin h616-x96q-u-boot-sunxi-with-spl.bin

# tanix_tx1
make clean
make tanix_tx1_defconfig
make -j 4

# prepare x96q for imagebuilder
dd if=/dev/zero of=boot-allwinner_h616-tanix_tx1-aarch64.dd bs=1024 count=8
cat u-boot-sunxi-with-spl.bin >> boot-allwinner_h616-tanix_tx1-aarch64.dd
cp u-boot.bin h616-tanix_tx1-u-boot.bin
cp u-boot-sunxi-with-spl.bin h616-tanix_tx1-u-boot-sunxi-with-spl.bin

# other mainline supported devices
make clean
make longanpi-3h_defconfig
make -j 4

# prepare longanpi-3h for imagebuilder
dd if=/dev/zero of=boot-allwinner_h616-longanpi-3h-aarch64.dd bs=1024 count=8
cat u-boot-sunxi-with-spl.bin >> boot-allwinner_h616-longanpi-3h-aarch64.dd
cp u-boot.bin h616-longanpi-3h-u-boot.bin
cp u-boot-sunxi-with-spl.bin h616-longanpi-3h-u-boot-sunxi-with-spl.bin

make clean
make orangepi_zero2_defconfig
make -j 4

# prepare orangepi_zero2 for imagebuilder
dd if=/dev/zero of=boot-allwinner_h616-orangepi_zero2-aarch64.dd bs=1024 count=8
cat u-boot-sunxi-with-spl.bin >> boot-allwinner_h616-orangepi_zero2-aarch64.dd
cp u-boot.bin h616-orangepi_zero2-u-boot.bin
cp u-boot-sunxi-with-spl.bin h616-orangepi_zero2-u-boot-sunxi-with-spl.bin

make clean
make orangepi_zero2w_defconfig
make -j 4

# prepare orangepi_zero2w for imagebuilder
dd if=/dev/zero of=boot-allwinner_h616-orangepi_zero2w-aarch64.dd bs=1024 count=8
cat u-boot-sunxi-with-spl.bin >> boot-allwinner_h616-orangepi_zero2w-aarch64.dd
cp u-boot.bin h616-orangepi_zero2w-u-boot.bin
cp u-boot-sunxi-with-spl.bin h616-orangepi_zero2w-u-boot-sunxi-with-spl.bin

make clean
make orangepi_zero3_defconfig
make -j 4

# prepare orangepi_zero3 for imagebuilder
dd if=/dev/zero of=boot-allwinner_h616-orangepi_zero3-aarch64.dd bs=1024 count=8
cat u-boot-sunxi-with-spl.bin >> boot-allwinner_h616-orangepi_zero3-aarch64.dd
cp u-boot.bin h616-orangepi_zero3-u-boot.bin
cp u-boot-sunxi-with-spl.bin h616-orangepi_zero3-u-boot-sunxi-with-spl.bin
